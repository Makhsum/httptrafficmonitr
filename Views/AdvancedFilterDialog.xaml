<ui:FluentWindow x:Class="HttpTrafficMonitor.Views.AdvancedFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:HttpTrafficMonitor.ViewModels"
        Title="Advanced Filter"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.DataContext>
        <vm:AdvancedFilterViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Advanced Filter"
                     MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

        <!-- Add condition row -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4" Padding="10,8" Margin="12,8,12,8">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="ADD CONDITION" Margin="0,0,0,6"/>
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding AvailableFields}" SelectedItem="{Binding NewField}"
                              AutomationProperties.AutomationId="AdvancedFilter.FieldComboBox"
                              Width="120" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableOperators}" SelectedItem="{Binding NewOperator}"
                              AutomationProperties.AutomationId="AdvancedFilter.OperatorComboBox"
                              Width="120" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AdvancedFilter.ValueTextBox"
                             Width="200" Padding="4,3" Margin="0,0,6,0"/>
                    <ui:Button Content="Add" Command="{Binding AddConditionCommand}"
                               AutomationProperties.AutomationId="AdvancedFilter.AddConditionButton"
                               Icon="{ui:SymbolIcon Add24}" Appearance="Primary"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Logic:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{x:Static vm:AdvancedFilterViewModel.LogicOperators}"
                              SelectedItem="{Binding LogicOp}" Width="80"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conditions list -->
        <DataGrid Grid.Row="2" Margin="12,0,12,0"
                  ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  AutomationProperties.AutomationId="AdvancedFilter.ConditionsGrid"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="120"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="120"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <ui:MenuItem Header="Remove Condition" Command="{Binding RemoveConditionCommand}"
                                 Icon="{ui:SymbolIcon Delete24}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Presets -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="4" Padding="10,8" Margin="12,8,12,0">
            <WrapPanel>
                <TextBlock Text="Preset:" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="AdvancedFilter.PresetNameTextBox"
                         Width="150" Padding="4,3" Margin="0,0,6,0"/>
                <ui:Button Content="Save" Command="{Binding SavePresetCommand}"
                           AutomationProperties.AutomationId="AdvancedFilter.SavePresetButton"
                           Icon="{ui:SymbolIcon Save24}" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          AutomationProperties.AutomationId="AdvancedFilter.PresetsComboBox"
                          DisplayMemberPath="Name" Width="150" Margin="0,0,6,0"/>
                <ui:Button Content="Delete" Command="{Binding DeletePresetCommand}"
                           AutomationProperties.AutomationId="AdvancedFilter.DeletePresetButton"
                           Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"/>
            </WrapPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="12,10,12,12">
            <ui:Button Content="Clear All" Command="{Binding ClearCommand}"
                       AutomationProperties.AutomationId="AdvancedFilter.ClearAllButton"
                       Icon="{ui:SymbolIcon Dismiss24}" Margin="0,0,6,0"/>
            <ui:Button Content="Apply Filter" Command="{Binding ApplyCommand}"
                       AutomationProperties.AutomationId="AdvancedFilter.ApplyFilterButton"
                       Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
